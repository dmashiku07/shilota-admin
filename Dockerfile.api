# syntax=docker/dockerfile:1

FROM node:22-bullseye AS dependencies

WORKDIR /app

COPY package.json package-lock.json ./

# Install the locked dependency tree once. The cache mount preserves downloaded
# packages across cold Docker layer rebuilds.
RUN --mount=type=cache,id=shilota-npm,target=/root/.npm \
    npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund

FROM dependencies AS build

# Keep Angular predictable on the resource-constrained staging host. CI mode
# disables Angular's persistent disk cache; Docker already caches this entire
# build layer after a successful build, so an inner cache only adds slow I/O.
ENV CI=true
ENV NG_BUILD_MAX_WORKERS=1
ENV NODE_OPTIONS=--max-old-space-size=2048

# Keep the expensive Angular build independent from backend-only changes.
COPY angular.json tsconfig.json browserslist ./
COPY scripts/write-runtime-config.js scripts/verify-admin-build.js ./scripts/
COPY src ./src

RUN npm run build:admin && npm run verify:admin-build

# These files change frequently but do not affect the compiled admin bundle.
COPY app.js ./app.js
COPY server ./server
COPY scripts ./scripts

# Derive production dependencies only after the Angular build. Basing this
# stage on `build` prevents BuildKit from running npm prune concurrently with
# Angular compilation and competing for limited staging CPU/RAM.
FROM build AS production-dependencies

RUN npm prune --omit=dev --legacy-peer-deps --ignore-scripts --no-audit --no-fund

FROM node:22-bullseye AS runtime

WORKDIR /app

COPY package.json package-lock.json ./
COPY --from=production-dependencies /app/node_modules ./node_modules

COPY --from=build /app/app.js ./app.js
COPY --from=build /app/server ./server
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/src ./src
COPY --from=build /app/dist ./dist

ENV NODE_ENV=production
ENV HTTPS_MODE=disable
ENV API_PORT=3000
ENV SOCKET_PORT=8081

EXPOSE 3000 8081

CMD ["npm", "start"]
