{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "paths": {
      "app/*": ["./src/app/*"],
      "environments/*": ["./src/environments/*"],
      "ngx-toastr": ["./src/app/shared/toast/toast-shim.ts"]
    },
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "types": [
      "googlemaps"
    ],
    "typeRoots": [
      "node_modules/@types",
    ],
    "skipLibCheck": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "angularCompilerOptions": {
    "preserveWhitespaces": false,
    "strictTemplates": false
  }
}
