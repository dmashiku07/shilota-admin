# Server-side settings
MONGO_URL=mongodb://mongodb:27017/cabi_db
JWT_SECRET=CHANGE_ME
API_PORT=3000
SOCKET_PORT=8081
TURN_URLS=turn:shilota.tz:3478?transport=udp,turn:shilota.tz:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_CREDENTIAL_TTL=3600
TURN_EXTERNAL_IP=replace-with-server-public-ip
HTTPS_MODE=disable
BASE_URL=http://localhost:3000

# Browser-safe runtime config
RUNTIME_API_URL=http://localhost:3000
RUNTIME_SOCKET_URL=http://localhost:8081
GOOGLE_MAPS_API_KEY=REPLACE_GOOGLE_MAPS_API_KEY
GOOGLE_LOGIN_CLIENT_ID=REPLACE_GOOGLE_LOGIN_CLIENT_ID
ENABLE_PHONE_VERIFICATION=false
FIREBASE_API_KEY=REPLACE_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_FIREBASE_AUTH_DOMAIN
FIREBASE_DATABASE_URL=REPLACE_FIREBASE_DATABASE_URL
FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=REPLACE_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=REPLACE_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=REPLACE_FIREBASE_APP_ID
FIREBASE_MEASUREMENT_ID=REPLACE_FIREBASE_MEASUREMENT_ID

# Firebase Admin SDK credentials for FCM HTTP v1
FIREBASE_ADMIN_PROJECT_ID=REPLACE_FIREBASE_ADMIN_PROJECT_ID
FIREBASE_ADMIN_CLIENT_EMAIL=REPLACE_FIREBASE_ADMIN_CLIENT_EMAIL
FIREBASE_ADMIN_PRIVATE_KEY="REPLACE_FIREBASE_ADMIN_PRIVATE_KEY"

# SMS provider settings
BEEM_API_KEY=REPLACE_BEEM_API_KEY
BEEM_SECRET_KEY=REPLACE_BEEM_SECRET_KEY
BEEM_SOURCE_ADDR=REPLACE_BEEM_SOURCE_ADDR

# Selcom payment gateway settings
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_API_KEY=REPLACE_SELCOM_API_KEY
SELCOM_API_SECRET=REPLACE_SELCOM_API_SECRET
SELCOM_VENDOR_ID=REPLACE_SELCOM_VENDOR_ID
SELCOM_VENDOR_PIN=REPLACE_SELCOM_VENDOR_PIN
SELCOM_REDIRECT_BASE_URL=http://localhost:3000/wallet-payment-success
SELCOM_WEBHOOK_URL=http://localhost:3000/api/selcom/callback

# LATRA / CeTS integration
CETS_ENABLED=false
CETS_BASE_URL=http://41.59.57.164:8080
CETS_AUDIENCE=http://41.59.57.164:8080
CETS_ISSUER=http://localhost:3000
CETS_SUBJECT=http://localhost:3000
CETS_KEY_ID=REPLACE_CETS_KEY_ID
CETS_PRIVATE_KEY="REPLACE_CETS_PRIVATE_KEY"
CETS_PUBLIC_KEY="REPLACE_CETS_PUBLIC_KEY"
CETS_DISCOVERY_PATH=/.well-known/tz-e-ticketing-server
CETS_JWKS_PATH=/cets/jwks
CETS_SUBMIT_DRIVER_PATH=/api/v1/ticket-engine/rideDriver/submitDriver
CETS_SUBMIT_VEHICLE_PATH=/api/v1/ticket-engine/rideVehicle/submitVehicle
CETS_SUBMIT_TRIP_PATH=/api/v1/ticket-engine/rideHailing/submitTrip
CETS_SUBMIT_REPORT_PATH=/api/v1/ticket-engine/rideReport/submitReport
CETS_BACKGROUND_SYNC_ENABLED=true
CETS_DEFAULT_RATING=0
